# Copie para .env (ignorado pelo git). Uso local: `cdk diff` e a criação única do
# papel OIDC. O deploy roda no GitHub Actions com os mesmos valores (Variables).

# ID da hosted zone de vsoller.com.br (sem ele, a zona é buscada pelo nome)
HOSTED_ZONE_ID=

# Claim do repo para o papel OIDC, sem "repo:" (ex.: VgsStudio/boulder-log)
# GITHUB_REPO_CLAIM=VgsStudio/boulder-log

# Opcionais (padrões entre parênteses)
# ZONE_NAME=vsoller.com.br
# APP_DOMAIN=boulder.vsoller.com.br
# COGNITO_DOMAIN_PREFIX=vgs-boulder-log
# AI_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0   (ou us.amazon.nova-lite-v1:0)
# AI_DAILY_LIMIT=20
# ALERT_EMAIL=            (alerta do AWS Budget de US$ 5; sem ele, não cria o budget)
